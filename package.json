{
  "name": "qa-pipeline",
  "version": "1.0.0",
  "description": "AI-powered QA platform built on OpenCode's agent infrastructure",
  "type": "module",
  "bin": {
    "qa-pipeline": "./bin/qa-pipeline"
  },
  "scripts": {
    "pipeline": "node orchestrator.js",
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:reporting": "node tests/test-reporting.js",
    "test:smoke": "node tests/test-reporting.js",
    "test:memory": "node tests/test-memory.js",
    "test:run-config": "node tests/test-run-config.js",
    "test:all": "node tests/test-reporting.js && node tests/test-memory.js && node tests/test-run-config.js"
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "ai",
    "opencode",
    "automation"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "playwright": "^1.40.0",
    "typescript": "^5.0.0"
  }
}
